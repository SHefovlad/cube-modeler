// Пример: простой домик. Демонстрирует кубы, вложенность и empty.

cube((0, 2, 0), (4, 4, 4), (0, 0, 0))              // стены
{
    cube((0, 0.6, 0), (0.4, 1.2, 0.4), (0, 0, 0))   // труба (локально)
}
cube((0, 4.4, 0), (5, 0.4, 5), (0, 0, 0))          // крыша-плита

empty((0, 0, 1.6), (0, 0, 0))                      // пивот крыльца
{
    cube((0, 0, 0), (2, 0.2, 0.6), (0, 0, 0))       // ступень (локально)
    cube((0, -0.4, 0.3), (0.2, 0.2, 0.2), (0, 30, 0))
}
