// Пример: простой домик. Демонстрирует кубы, цвета, вложенность и empty.

cube((0, 2, 0), (4, 4, 4), (0, 0, 0), "#b05a3c")              // стены
{
    cube((0, 0.6, 0), (0.4, 1.2, 0.4), (0, 0, 0), "#8b3a2a")   // труба (локально)
}
cube((0, 4.4, 0), (5, 0.4, 5), (0, 0, 0), "#6b4226")          // крыша-плита

empty((0, 0, 1.6), (0, 0, 0))                                 // пивот крыльца
{
    cube((0, 0, 0), (2, 0.2, 0.6), (0, 0, 0), "#8a8a8a")       // ступень (локально)
    cube((0, -0.4, 0.3), (0.2, 0.2, 0.2), (0, 30, 0), "#5c8a3a")
}
